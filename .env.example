# Local development defaults. Change every secret before deploying.
APP_ENV=development
APP_NAME=杠杆 ETF 贪恐策略系统
DATABASE_URL=sqlite:///./leveraged_etf.db
ADMIN_USERNAME=53
ADMIN_PASSWORD=change-me-now
# Preferred in production: generate with `python -m app.cli hash-password`.
ADMIN_PASSWORD_HASH=
JWT_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
BASE_CURRENCY=CNY
PUBLIC_BASE_URL=http://localhost:8000
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
AUTO_FETCH_MARKET_DATA=true
MARKET_DATA_LOOKBACK_YEARS=8
DATA_STALE_HOURS=36
BACKUP_DIR=/backups
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=leveraged_etf
POSTGRES_USER=leveraged_etf
POSTGRES_PASSWORD=replace-me
DOMAIN=localhost

